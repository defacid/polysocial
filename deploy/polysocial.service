[Unit]
Description=Polysocial local posting service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_DIR@
Environment=POLYSOCIAL_PUBLIC_ORIGIN=@PUBLIC_ORIGIN@
Environment=POLYSOCIAL_DATA_DIR=@DATA_DIR@
ExecStart=/usr/bin/python3 "@PROJECT_DIR@/server.py" --port @PORT@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
