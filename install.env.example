# Copy this file to install.env before installing system services.
# Do not commit the copied file.
POLYSOCIAL_PUBLIC_ORIGIN=https://social.example.com
POLYSOCIAL_PORT=5500
POLYSOCIAL_BIND=127.0.0.1
# Optional file containing exactly username:password, mode 600.
# POLYSOCIAL_AUTH_FILE=/home/your-linux-user/.local/share/polysocial/basic-auth
# POLYSOCIAL_SERVICE_USER=your-linux-user
# POLYSOCIAL_DATA_DIR=/home/your-linux-user/.local/share/polysocial
